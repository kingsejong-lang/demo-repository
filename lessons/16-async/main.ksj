# 비동기 함수 는 호출하면 바로 프로미스를 돌려준다.
더하기 = 비동기 함수(a, b) {
    반환 a + b
}

p = 더하기(1, 2)
출력(타입(p))

# 대기 는 프로미스가 끝날 때까지 기다려 값을 꺼낸다.
출력(대기 p)

# 비동기 함수 안에서 다른 비동기 함수를 기다릴 수 있다.
합계 = 비동기 함수(목록) {
    결과 = 0
    i가 0부터 길이(목록) 미만 {
        결과 = 대기 더하기(결과, 목록[i])
    }
    반환 결과
}
출력(대기 합계([1, 2, 3, 4]))

# 거부된 프로미스를 기다리면 오류가 던져진다.
실패 = 비동기 함수() {
    던지다 "연결 실패"
}
시도 {
    대기 실패()
} 오류 (e) {
    출력("잡음:", e)
}

# 그러면 으로 결과를 이어서 가공한다.
출력(대기 더하기(2, 3).그러면(함수(값) { 반환 값 * 10 }))
