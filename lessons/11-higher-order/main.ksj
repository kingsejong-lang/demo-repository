# 함수를 인자로 받는 함수
두번_적용 = 함수(f, x) {
    반환 f(f(x))
}
더하기3 = 함수(x) { 반환 x + 3 }
출력(두번_적용(더하기3, 10))

# 함수를 돌려주는 함수
곱하기_만들기 = 함수(n) {
    반환 함수(x) { 반환 x * n }
}
세배 = 곱하기_만들기(3)
출력(세배(7))

# 클로저: 안쪽 함수가 바깥 변수를 기억한다.
카운터_만들기 = 함수() {
    개수 = 0
    반환 함수() {
        개수 = 개수 + 1
        반환 개수
    }
}
카운터 = 카운터_만들기()
카운터()
카운터()
출력("세 번째 호출:", 카운터())

# 다른 카운터는 따로 센다.
다른_카운터 = 카운터_만들기()
출력("새 카운터:", 다른_카운터())
