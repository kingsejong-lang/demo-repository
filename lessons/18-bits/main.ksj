# 16진수(0x)와 2진수(0b) 리터럴, 지수(1e3) 리터럴
출력(0xFF, 0b1010, 1e3)

# 비트 연산: 그리고(&), 또는(|), 배타적 또는(^), 뒤집기(~)
a = 0b1100
b = 0b1010
출력(a & b, a | b, a ^ b, ~a)

# 밀기: << 는 왼쪽으로(2를 곱함), >> 는 오른쪽으로(2로 나눔)
출력(1 << 10, 1024 >> 3)

# 비트 하나를 켜고, 끄고, 확인하기 (권한 플래그)
읽기 = 1 << 0
쓰기 = 1 << 1
실행 = 1 << 2
권한 = 읽기 | 실행
출력("쓰기 가능:", (권한 & 쓰기) != 0)
권한 = 권한 | 쓰기
출력("쓰기 가능:", (권한 & 쓰기) != 0)
권한 = 권한 & ~실행
출력("실행 가능:", (권한 & 실행) != 0)

# 켜진 비트 세기
함수 비트수(n) {
    개수 = 0
    반복 (n != 0) {
        개수 = 개수 + (n & 1)
        n = n >> 1
    }
    반환 개수
}
출력(비트수(0b10110111), 비트수(255))

# 2진수 문자열로 보기
함수 이진수(n) {
    만약 (n == 0) {
        반환 "0"
    }
    글 = ""
    반복 (n != 0) {
        글 = "${n & 1}" + 글
        n = n >> 1
    }
    반환 글
}
출력(이진수(10), 이진수(0xFF))
