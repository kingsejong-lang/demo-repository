# 던지다 로 오류를 일으키고, 시도/오류 로 잡는다.
나누기 = 함수(a, b) {
    만약 (b == 0) {
        던지다 "0으로 나눌 수 없습니다"
    }
    반환 a / b
}

시도 {
    출력(나누기(10, 2))
    출력(나누기(1, 0))
    출력("이 줄은 실행되지 않는다")
} 오류 (e) {
    출력("잡은 오류:", e)
}

# 마지막 블록은 오류가 나든 안 나든 항상 실행된다.
시도 {
    출력("작업 시작")
    던지다 "작업 실패"
} 오류 (e) {
    출력("처리:", e)
} 마지막 {
    출력("정리 완료")
}

# 잡은 오류를 다시 던지면 바깥 시도가 받는다.
시도 {
    시도 {
        던지다 "안쪽 오류"
    } 오류 (e) {
        출력("안쪽에서 확인:", e)
        던지다 e
    }
} 오류 (e) {
    출력("바깥에서 받음:", e)
}
