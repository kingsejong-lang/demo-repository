# N번 반복: 횟수만 정할 때
3번 반복한다 {
    출력("만세")
}

# 범위 반복: 까지는 끝을 포함하고, 미만은 포함하지 않는다.
i가 1부터 5까지 {
    출력(i)
}
i가 0부터 3 미만 {
    출력("미만:", i)
}

# 조건 반복: 조건이 참인 동안 돈다.
합 = 0
n = 1
반복 (n <= 100) {
    합 = 합 + n
    n = n + 1
}
출력("1부터 100까지의 합:", 합)

# 거꾸로 세기: 이상으로 끝나면 1씩 줄인다.
i가 3부터 1 이상 {
    출력("카운트다운:", i)
}

# 중단은 반복문을 끝내고, 계속은 이번 회차를 건너뛴다.
i가 1부터 10까지 {
    만약 (i % 2 == 0) {
        계속
    }
    만약 (i > 7) {
        중단
    }
    출력("홀수:", i)
}

# 찾으면 바로 멈추기
목록 = [4, 8, 15, 16, 23, 42]
찾은_위치 = -1
i가 0부터 길이(목록) 미만 {
    만약 (목록[i] == 15) {
        찾은_위치 = i
        중단
    }
}
출력("15의 위치:", 찾은_위치)

# 구구단 2단
i가 1부터 9까지 {
    출력("2 x ${i} = ${2 * i}")
}
