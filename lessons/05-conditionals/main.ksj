학점 = 함수(점수) {
    만약 (점수 >= 90) {
        반환 "A"
    } 아니면 만약 (점수 >= 80) {
        반환 "B"
    } 아니면 만약 (점수 >= 70) {
        반환 "C"
    } 아니면 {
        반환 "F"
    }
}

출력(학점(95), 학점(85), 학점(72), 학점(40))

# 조건에는 논리 값(참/거짓)이 와야 한다.
# 문자열이 비었는지는 길이를 비교해서 확인한다.
메모 = ""
만약 (길이(메모) == 0) {
    출력("메모가 비어 있습니다")
}

나이 = 20
회원 = 참
만약 (나이 >= 18 그리고 회원) {
    출력("입장할 수 있습니다")
}
