# 재귀: 함수가 자기 자신을 부른다. 멈추는 조건이 꼭 있어야 한다.
계승 = 함수(n) {
    만약 (n <= 1) {
        반환 1
    }
    반환 n * 계승(n - 1)
}
출력("5! =", 계승(5))

피보나치 = 함수(n) {
    만약 (n < 2) {
        반환 n
    }
    반환 피보나치(n - 1) + 피보나치(n - 2)
}
i가 0부터 10까지 {
    출력("fib(${i}) =", 피보나치(i))
}

# 하노이의 탑: 원판 n개를 출발에서 도착으로 옮긴다.
하노이 = 함수(n, 출발, 도착, 경유) {
    만약 (n == 0) {
        반환 0
    }
    앞 = 하노이(n - 1, 출발, 경유, 도착)
    출력("원판 ${n}: ${출발} -> ${도착}")
    뒤 = 하노이(n - 1, 경유, 도착, 출발)
    반환 앞 + 1 + 뒤
}
출력("옮긴 횟수:", 하노이(3, "A", "C", "B"))
