# 도형 모듈. 이름이 _ 로 시작하면 이 파일 안에서만 쓴다.
# 가져오기 는 _ 이름을 가져가지 않는다.

_원주율 = 3.14159

# 길이가 0 이하이면 오류를 낸다. 모듈 안의 함수들이 함께 쓰는 도우미다.
_길이_확인 = 함수(값) {
    만약 (값 <= 0) {
        던지다 "길이는 0보다 커야 합니다: " + 문자열(값)
    }
    반환 값
}

원_넓이 = 함수(반지름) {
    r = _길이_확인(반지름)
    반환 _원주율 * r * r
}

사각형_넓이 = 함수(가로, 세로) {
    반환 _길이_확인(가로) * _길이_확인(세로)
}
