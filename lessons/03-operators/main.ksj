a = 17
b = 5

# 정수끼리 나누면 몫만 남는다. 소수점이 필요하면 실수를 쓴다.
출력("더하기:", a + b)
출력("빼기:", a - b)
출력("곱하기:", a * b)
출력("나누기:", a / b)
출력("나머지:", a % b)
출력("실수 나누기:", 17.0 / 4)

# 비교 연산의 결과는 참 또는 거짓이다.
출력(a > b, a == b, a != b)

# 논리 연산은 기호(&&, ||, !)나 낱말(그리고, 또는)로 쓴다.
출력(a > 10 그리고 b > 10)
출력(a > 10 또는 b > 10)
출력(!(a > 10))

# 문자열에 정수를 곱하면 반복된다.
출력("-" * 10)
