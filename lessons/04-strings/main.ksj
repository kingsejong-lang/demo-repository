이름 = "세종대왕"

# 길이는 바이트가 아니라 글자 수다.
출력(길이(이름))

# + 로 이어 붙이고, 숫자는 문자열() 로 바꿔서 붙인다.
출력("이름: " + 이름 + ", 글자 수: " + 문자열(길이(이름)))

# ${...} 안에 식을 넣으면 그 값이 문자열에 들어간다.
출력("${이름}의 이름은 ${길이(이름)}글자입니다")

# 부분문자열(문자열, 시작, 끝) 은 [시작, 끝) 구간을 글자 단위로 자른다.
출력(부분문자열(이름, 0, 2))
출력(부분문자열(이름, 2))

# 포함() 은 부분 문자열이 있는지 확인한다.
출력(포함(이름, "대왕"), 포함(이름, "장군"))

# 숫자 모양의 문자열은 정수() 나 실수() 로 바꾼다.
출력(정수("41") + 1, 실수("2.5") * 3)
