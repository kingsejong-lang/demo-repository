# 각각: 인덱스 없이 컬렉션의 값을 하나씩 받는다.
과일들 = ["사과", "배", "포도"]
과일들 각각에 대해 과일로 {
    출력(과일)
}

# 문자열은 글자를 하나씩 준다.
"세종" 각각에 대해 글자로 {
    출력(글자)
}

# 합과 최댓값
점수들 = [72, 95, 88, 61]
합 = 0
최고 = 점수들[0]
점수들 각각에 대해 점수로 {
    합 = 합 + 점수
    만약 (점수 > 최고) {
        최고 = 점수
    }
}
출력("합:", 합, "최고:", 최고)

# 중단과 계속도 쓸 수 있다.
[3, -1, 4, 0, 5] 각각에 대해 수로 {
    만약 (수 < 0) {
        계속
    }
    만약 (수 == 0) {
        중단
    }
    출력("양수:", 수)
}

# 회차마다 새 변수가 생겨서, 함수가 그 회차의 값을 기억한다.
함수들 = []
[1, 2, 3] 각각에 대해 n으로 {
    함수들에 덧붙인다(함수() { 반환 n * 10 })
}
함수들 각각에 대해 f로 {
    출력(f())
}
