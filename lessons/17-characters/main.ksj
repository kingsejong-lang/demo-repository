# 문자열도 배열처럼 인덱스로 글자를 꺼낸다. 글자는 바이트가 아니라 한 글자씩 센다.
인사 = "안녕하세요"
출력(인사[0], 인사[4], 인사[-1])
출력(인사[0부터 2까지])
출력(인사[2부터 5미만])

# 문자코드는 글자를 유니코드 번호로, 코드문자는 번호를 글자로 바꾼다.
출력(문자코드("A"), 문자코드("가"))
출력(코드문자(66), 코드문자(44033))

# 영문 소문자를 대문자로: 번호에서 32를 뺀다.
함수 대문자로(글) {
    결과 = ""
    i가 0부터 길이(글) 미만 {
        코드 = 문자코드(글[i])
        만약 (코드 >= 97 && 코드 <= 122) {
            코드 = 코드 - 32
        }
        결과 = 결과 + 코드문자(코드)
    }
    반환 결과
}
출력(대문자로("hello, 세종!"))

# 한글 음절은 44032(가)부터 차례로 놓여 있어 초성을 셈으로 구한다.
초성들 = ["ㄱ", "ㄲ", "ㄴ", "ㄷ", "ㄸ", "ㄹ", "ㅁ", "ㅂ", "ㅃ", "ㅅ", "ㅆ", "ㅇ", "ㅈ", "ㅉ", "ㅊ", "ㅋ", "ㅌ", "ㅍ", "ㅎ"]
함수 초성(글자) {
    반환 초성들[(문자코드(글자) - 44032) / 588]
}
출력(초성("세"), 초성("종"), 초성("대"), 초성("왕"))
