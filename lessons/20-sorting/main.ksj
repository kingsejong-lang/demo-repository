# 정렬한다는 작은 값부터 늘어놓는다.
수들 = [5, 2, 9, 1]
출력(수들을 정렬한다)

# 비교 함수를 주면 순서를 정할 수 있다. 음수면 앞 값이, 양수면 뒤 값이 먼저 온다.
출력(수들을 정렬한다(함수(a, b) { 반환 b - a }))

# 배열의 배열을 둘째 값(나이)으로 정렬하기
사람들 = [["철수", 31], ["영희", 25], ["민수", 28]]
나이순 = 사람들을 정렬한다(함수(p, q) { 반환 p[1] - q[1] })
나이순 각각에 대해 사람으로 {
    출력(사람[0], 사람[1])
}

# 비교 결과가 같으면 원래 순서를 지킨다(안정 정렬).
단어들 = ["bb", "a", "cc", "d"]
출력(단어들을 정렬한다(함수(x, y) { 반환 길이(x) - 길이(y) }))

# 길이는 사전의 키 개수도 센다.
재고 = {"사과": 3, "배": 0, "포도": 7}
출력("품목 수:", 길이(재고))
