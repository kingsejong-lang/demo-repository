과일 = ["사과", "배", "감"]

# 인덱스는 0부터 센다.
출력(과일[0], 과일[2])
출력("개수:", 길이(과일))

# 요소를 바꾸고, + 나 추가() 로 새 요소를 붙인다.
과일[1] = "귤"
과일 = 과일 + ["포도"]
과일 = 추가(과일, "참외")
출력(과일)

# 범위로 잘라내기: 까지는 끝 포함, 미만은 끝 제외
숫자들 = [10, 20, 30, 40, 50]
출력(숫자들[1부터 3까지])
출력(숫자들[0부터 2미만])

# 배열을 차례로 도는 방법
합 = 0
i가 0부터 길이(숫자들) 미만 {
    합 = 합 + 숫자들[i]
}
출력("합:", 합)

출력(포함(숫자들, 30))
