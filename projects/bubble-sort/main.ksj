# 버블 정렬: 이웃한 두 값을 비교해 큰 값을 뒤로 보낸다.
버블_정렬 = 함수(원본) {
    목록 = 원본 + []
    n = 길이(목록)
    i가 0부터 n - 1 미만 {
        바뀜 = 거짓
        j가 0부터 n - 1 - i 미만 {
            만약 (목록[j] > 목록[j + 1]) {
                임시 = 목록[j]
                목록[j] = 목록[j + 1]
                목록[j + 1] = 임시
                바뀜 = 참
            }
        }
        출력("${i + 1}회차:", 목록)
        # 한 번도 바꾸지 않았으면 이미 정렬된 것이다.
        만약 (!바뀜) {
            반환 목록
        }
    }
    반환 목록
}

데이터 = [5, 1, 4, 2, 8]
정렬됨 = 버블_정렬(데이터)
출력("결과:", 정렬됨)
출력("원본은 그대로:", 데이터)
출력("내장 정렬:", 데이터를 정렬한다)
