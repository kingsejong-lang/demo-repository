# 에라토스테네스의 체: 2부터 한계까지의 소수를 모두 찾는다.
가져오기 "stdlib/array"

체 = 함수(한계) {
    # 소수[i] 가 참이면 i 는 아직 지워지지 않은 수다.
    소수 = 채우기(참, 한계 + 1)
    소수[0] = 거짓
    소수[1] = 거짓
    i = 2
    반복 (i * i <= 한계) {
        만약 (소수[i]) {
            배수 = i * i
            반복 (배수 <= 한계) {
                소수[배수] = 거짓
                배수 = 배수 + i
            }
        }
        i = i + 1
    }
    결과 = []
    i가 2부터 한계까지 {
        만약 (소수[i]) {
            결과 = 추가(결과, i)
        }
    }
    반환 결과
}

출력(체(50))
출력("100 이하 소수 개수:", 길이(체(100)))
